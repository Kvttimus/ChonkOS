{
    "configurations": [
        {
            "name": "Watcom",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_cdecl=",
                "__far=",
                "__interrupt=",
                "__attribute__(x)="
            ],
            "compilerPath": "/usr/bin/watcom/binl64/wcc",
            "cStandard": "c99",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-0 -d3 -s -wx -ml -zl -zq "
            ]
        }
    ],
    "version": 4
}